# Database connection URL (PostgreSQL)
# For local development: postgresql://user:password@localhost:5432/mealbot
# On Heroku: automatically set as DATABASE_URL
DATABASE_URL=postgresql://localhost:5432/mealbot

# Server port (default: 8080)
PORT=8080

# Auth0 configuration (used for JWT authentication)
AUTH0_DOMAIN=mealbot.auth0.com
AUTH0_AUDIENCE=https://mealbot-2.herokuapp.com/

# Mailgun configuration (used for sending pairing emails)
MAILGUN_DOMAIN=
MAILGUN_API_KEY=
MAILGUN_FROM=
